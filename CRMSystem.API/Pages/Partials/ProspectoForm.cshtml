@page
@model CRMSystem.API.Pages.Partials.ProspectoFormModel

<div class="modal-header">
    <h5 class="modal-title">@(Model.ProspectoId.HasValue ? "Editar" : "Nuevo") Prospecto</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
</div>
<div class="modal-body">
    <form id="prospecto-form">
        <input type="hidden" id="prospecto-id" value="@Model.ProspectoId">
        
        <div class="row mb-3">
            <div class="col-md-6">
                <label class="form-label">Nombre de la Empresa *</label>
                <input type="text" class="form-control" name="nombreEmpresa" value="@Model.Prospecto?.NombreEmpresa" required>
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-md-6">
                <label class="form-label">Nombre del Contacto *</label>
                <input type="text" class="form-control" name="nombreContacto" value="@Model.Prospecto?.NombreContacto" required>
            </div>
            <div class="col-md-6">
                <label class="form-label">Apellido del Contacto *</label>
                <input type="text" class="form-control" name="apellidoContacto" value="@Model.Prospecto?.ApellidoContacto" required>
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-md-6">
                <label class="form-label">Email *</label>
                <input type="email" class="form-control" name="email" value="@Model.Prospecto?.Email" required>
            </div>
            <div class="col-md-6">
                <label class="form-label">Teléfono</label>
                <input type="tel" class="form-control" name="telefono" value="@Model.Prospecto?.Telefono">
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-md-6">
                <label class="form-label">Fuente *</label>
                <select class="form-select" name="fuenteProspectoId" required>
                    <option value="">Seleccione...</option>
                    @foreach (var fuente in Model.Fuentes)
                    {
                        <option value="@fuente.Id" selected="@(Model.Prospecto?.FuenteId == fuente.Id)">@fuente.NombreFuente</option>
                    }
                </select>
            </div>
            <div class="col-md-6">
                <label class="form-label">Estado</label>
                <select class="form-select" name="estadoProspecto">
                    <option value="Nuevo" selected="@(Model.Prospecto?.EstadoProspecto == "Nuevo")">Nuevo</option>
                    <option value="Contactado" selected="@(Model.Prospecto?.EstadoProspecto == "Contactado")">Contactado</option>
                    <option value="Calificado" selected="@(Model.Prospecto?.EstadoProspecto == "Calificado")">Calificado</option>
                    <option value="Propuesta" selected="@(Model.Prospecto?.EstadoProspecto == "Propuesta")">Propuesta</option>
                </select>
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-md-6">
                <label class="form-label">Sucursal *</label>
                <select class="form-select" name="sucursalId" required>
                    <option value="">Seleccione...</option>
                    <option value="1" selected="@(Model.Prospecto?.SucursalId == 1)">Norte</option>
                    <option value="2" selected="@(Model.Prospecto?.SucursalId == 2)">Centro</option>
                    <option value="3" selected="@(Model.Prospecto?.SucursalId == 3)">Sur</option>
                </select>
            </div>
            <div class="col-md-6">
                <label class="form-label">Vendedor Asignado</label>
                <select class="form-select" name="vendedorAsignadoId">
                    <option value="">Sin asignar</option>
                    <option value="1" selected="@(Model.Prospecto?.VendedorAsignadoId == 1)">Juan Pérez</option>
                    <option value="2" selected="@(Model.Prospecto?.VendedorAsignadoId == 2)">María García</option>
                    <option value="3" selected="@(Model.Prospecto?.VendedorAsignadoId == 3)">Carlos López</option>
                </select>
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label">Notas</label>
            <textarea class="form-control" name="notas" rows="3">@Model.Prospecto?.Notas</textarea>
        </div>
    </form>
</div>
<div class="modal-footer">
    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
    <button type="button" class="btn btn-primary" onclick="saveProspecto()">Guardar</button>
</div>

<script>
    async function saveProspecto() {
        const form = document.getElementById('prospecto-form');
        if (!form.checkValidity()) {
            form.reportValidity();
            return;
        }

        const formData = new FormData(form);
        const data = Object.fromEntries(formData.entries());

        // Convert IDs to numbers
        data.fuenteProspectoId = parseInt(data.fuenteProspectoId);
        data.sucursalId = parseInt(data.sucursalId);
        if (data.vendedorAsignadoId) {
            data.vendedorAsignadoId = parseInt(data.vendedorAsignadoId);
        }

        try {
            const prospectoId = document.getElementById('prospecto-id').value;
            const url = prospectoId ? `/api/Prospectos/${prospectoId}` : '/api/Prospectos';
            const method = prospectoId ? 'PUT' : 'POST';

            const response = await fetch(url, {
                method: method,
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(data)
            });

            if (response.ok) {
                // Close modal
                bootstrap.Modal.getInstance(document.getElementById('crudModal')).hide();

                // Refresh list
                htmx.trigger('#prospectos-list', 'load');

                // Show notification
                if (window.showNotification) {
                    showNotification(prospectoId ? 'Prospecto actualizado' : 'Prospecto creado', 'success');
                }
            } else {
                const error = await response.json();
                alert('Error: ' + (error.title || 'No se pudo guardar el prospecto'));
            }
        } catch (error) {
            console.error('Error saving prospecto:', error);
            alert('Error al guardar: ' + error.message);
        }
    }
</script>

